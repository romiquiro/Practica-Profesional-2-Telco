-- Nota: en el modelo normalizado, tipo_contrato y metodo_pago estan en
-- tablas de catalogo (tipos_contrato, metodos_pago) y id_cliente esta en
-- contratos; por eso se usan JOIN con alias para reconstruirlos.
-- =====================================================================
USE telco;
 
-- ---------------------------------------------------------------------
-- EJERCICIO 1: 
SELECT
    c.id_cliente   AS cliente_id,
    c.genero       AS genero_cliente,
    c.adulto_mayor AS es_adulto_mayor
FROM clientes AS c;
 
-- ---------------------------------------------------------------------
-- EJERCICIO 2:
SELECT
    ct.id_cliente    AS cliente_id,
    tc.nombre        AS tipo_contrato,
    f.cargo_mensual  AS cargo_mensual
FROM facturacion AS f
JOIN contratos       AS ct ON ct.id_contrato      = f.id_contrato
JOIN tipos_contrato  AS tc ON tc.id_tipo_contrato = ct.id_tipo_contrato
WHERE f.cargo_mensual > 70.00;
 
-- ---------------------------------------------------------------------
-- EJERCICIO 3:
-- 3.1) Contrato 'Month-to-month' Y cargo mensual mayor a 50.00
SELECT
    ct.id_cliente    AS cliente_id,
    tc.nombre        AS tipo_contrato,
    f.cargo_mensual  AS cargo_mensual
FROM facturacion AS f
JOIN contratos       AS ct ON ct.id_contrato      = f.id_contrato
JOIN tipos_contrato  AS tc ON tc.id_tipo_contrato = ct.id_tipo_contrato
WHERE tc.nombre = 'Month-to-month'
  AND f.cargo_mensual > 50.00;
 
-- 3.2) Se suman los clientes que pagan con 'Electronic check'
SELECT
    ct.id_cliente    AS cliente_id,
    tc.nombre        AS tipo_contrato,
    mp.nombre        AS metodo_pago,
    f.cargo_mensual  AS cargo_mensual
FROM facturacion AS f
JOIN contratos       AS ct ON ct.id_contrato      = f.id_contrato
JOIN tipos_contrato  AS tc ON tc.id_tipo_contrato = ct.id_tipo_contrato
JOIN metodos_pago    AS mp ON mp.id_metodo_pago   = f.id_metodo_pago
WHERE (tc.nombre = 'Month-to-month' AND f.cargo_mensual > 50.00)
   OR mp.nombre = 'Electronic check';
 
-- ---------------------------------------------------------------------
-- EJERCICIO 4:
-- 4.1) Metodos de pago que contienen la palabra 'Electronic'
SELECT
    ct.id_cliente    AS cliente_id,
    mp.nombre        AS metodo_pago,
    f.cargo_mensual  AS cargo_mensual
FROM facturacion AS f
JOIN contratos     AS ct ON ct.id_contrato    = f.id_contrato
JOIN metodos_pago  AS mp ON mp.id_metodo_pago = f.id_metodo_pago
WHERE mp.nombre LIKE '%Electronic%';
 
-- 4.2) Mismo resultado, ordenado por cargo mensual de mayor a menor
SELECT
    ct.id_cliente    AS cliente_id,
    mp.nombre        AS metodo_pago,
    f.cargo_mensual  AS cargo_mensual
FROM facturacion AS f
JOIN contratos     AS ct ON ct.id_contrato    = f.id_contrato
JOIN metodos_pago  AS mp ON mp.id_metodo_pago = f.id_metodo_pago
WHERE mp.nombre LIKE '%Electronic%'
ORDER BY f.cargo_mensual DESC;
 
-- ---------------------------------------------------------------------
-- EJERCICIO 5
  
SELECT
    ct.id_cliente    AS cliente_id,
    f.cargo_total    AS cargo_total_acumulado
FROM facturacion AS f
JOIN contratos AS ct ON ct.id_contrato = f.id_contrato
ORDER BY f.cargo_total DESC,
         ct.id_cliente ASC          
LIMIT 5;
 
